#If a user registers with a username that matches the value of this variable, they will be granted administrator rights.
INITIAL_ADMIN_USERNAME=

# SECRET_KEY is optional. If not provided, a secure key will be automatically
# generated and stored in the persistent data volume.
# Set this variable only if you need to manually override the key.
SECRET_KEY=

# ENCRYPTION_KEY is required for encrypting sensitive data like email passwords.
# Generate a strong, URL-safe key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Set to "true" to seed the database with development data on the first run.
# Leave it "false" for anything another person can reach. With "true" and an empty
# database the seeder creates the administrator `markus` plus a handful of demo accounts
# and prints their generated passwords once, into the container log — it no longer hands
# them the password `1`, but a log pane is not a credential store. `deploy_truenas.sh`
# already defaults the generated TrueNAS YAML to false; this file used to ship "true",
# which is how a development default reached a deployment.
SEED_DEV_DATA=false

# How many reverse-proxy hops may rewrite X-Forwarded-* / Forwarded. "1" is what
# docker-compose.yml needs, because its nginx is the only peer that can reach the app at
# all, and that hop is what puts https and the public host into a password-reset link.
# "0" makes those headers inert instead of trusted: ProxyFix counts hops, not source
# addresses, so any value above 0 is a claim that whatever peer reached this socket is a
# proxy. Never publish :8081 with this above 0.
TRUSTED_PROXY_HOPS=1

# Database locations. Both default to SQLite files under persistent/ (user_data.db and the
# ~1.7 GB usda_data.db), which is what the shipped image uses; set them only to move a bind
# elsewhere. FLASK_APP=app.py only matters for the `flask` CLI outside the container.
DATABASE_URL=
USDA_DATABASE_URL=
FLASK_APP=

# Email Configuration Source: 'database' to manage settings via admin panel, or 'environment' to use environment variables.
MAIL_CONFIG_SOURCE=environment

# Enable or disable the password reset feature (true/false).
# The primary reason to configure email settings is to enable this feature.
ENABLE_PASSWORD_RESET=

# Enable or disable email verification for new user registrations (true/false).
ENABLE_EMAIL_VERIFICATION=

# Mail Server Hostname or IP address
MAIL_SERVER=
# Mail Server Port (e.g., 25, 465 for SSL, 587 for TLS)
MAIL_PORT=
# Use TLS (Transport Layer Security) for secure connection (true/false)
MAIL_USE_TLS=
# Use SSL (Secure Sockets Layer) for secure connection (true/false)
MAIL_USE_SSL=
# Username for mail server authentication
MAIL_USERNAME=
# Password for mail server authentication
MAIL_PASSWORD=
# Sender email address for outgoing emails
MAIL_FROM=
# Suppress email sending (useful for development/testing) (true/false)
MAIL_SUPPRESS_SEND=

# TrueNAS Registry URL for deploying Docker images (e.g., your-truenas-ip:5000)
TRUENAS_REGISTRY_URL='registry.myserver.net:12345'

# Repository path component deploy_truenas.sh pushes under, so images land at
# <registry>/<this>/<name>. Unset means "library", which is what TrueNAS itself asks a
# registry for when the pushed name has no such component — push without a namespace and
# the Apps "update available" badge never appears (DEV-README.md, Step 2.2). Change it only
# if your registry requires a particular namespace.
TRUENAS_REGISTRY_NAMESPACE=library

# TrueNAS Nginx Certificate Paths (used in TrueNAS UI deployment)
TRUENAS_REAL_CERT_PATH="/etc/certificates/Production.crt"
TRUENAS_REAL_KEY_PATH="/etc/certificates/Production.key"

# TrueNAS Application Base Path (e.g., /mnt/data-pool/opennourish)
TRUENAS_APP_PATH="/mnt/data-pool/opennourish"