# Direct dependencies — this is the hand-edited surface.
# requirements.txt is GENERATED from this file; do not hand-edit it (see DEV-README.md).
#   pip-compile --strip-extras -o requirements.txt requirements.in   (run with the 3.12 interpreter;
#   --strip-extras is required or gen_licenses.py reads "coverage[toml]" as a package name and fails)
# Interpreter: Python 3.12 (Dockerfile base image and the conda env must match).

